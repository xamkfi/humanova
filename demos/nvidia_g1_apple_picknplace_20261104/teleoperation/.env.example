# This is a Bash environment file, loaded automatically by demo.sh.
# Paths may contain spaces. DEMO_DIR is the absolute path to this demo folder.
DEMO_STATE_DIR="${DEMO_DIR}/.local"
DEMO_IMAGE="humanova/g1-apple-vr:arena-8b4a3a47"
DEMO_CONTAINER="humanova-g1-apple-vr"

# CPU physics matches the original VR practice command; rendering uses the GPU.
PHYSICS_DEVICE=cpu
ENABLE_CAMERAS=0

# Recording always enables cameras. Paths are relative to .local/datasets
# (or DEMO_STATE_DIR/datasets), mounted at /datasets inside the container.
RECORD_DATASET_FILE=isaaclab_arena/static_apple_tutorial/arena_g1_static_apple_dataset_recorded.hdf5
RECORD_NUM_DEMOS=20
RECORD_NUM_SUCCESS_STEPS=10

# Your workstation's LAN IPv4 address, as reachable from the headset.
# Used by "connect" to print the headset URLs; not a container or Thor address.
HEADSET_SERVER_IP=

# Inherit the logged-in desktop session. For Wayland, enable/use XWayland.
DISPLAY="${DISPLAY:-:0}"
XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

# Same Isaac Sim runtime settings as NVIDIA's Arena launcher.
# Review the linked terms in README.md before launching.
ACCEPT_EULA=Y
PRIVACY_CONSENT=Y

# Optional: clone from an existing local Arena checkout to avoid downloading its
# Git objects again. It is only read; its local changes are NOT copied.
# ARENA_CLONE_SOURCE="$HOME/IsaacLab-Arena"
